# ---- Public address of this server (your ngrok URL, no trailing slash) ----
PUBLIC_BASE_URL=https://your-name.ngrok-free.dev

# ---- Shopify ----
SHOPIFY_SHOP_DOMAIN=your-store.myshopify.com
SHOPIFY_ACCESS_TOKEN=shpat_xxx          # needs read_orders + write_orders
SHOPIFY_WEBHOOK_SECRET=xxx              # signing secret shown under Settings > Notifications > Webhooks
SHOPIFY_API_VERSION=2026-07             # check the currently supported version
STORE_NAME=Your Store Name              # spoken in the greeting

# ---- Exotel ----
EXOTEL_ACCOUNT_SID=xxx
EXOTEL_API_KEY=xxx
EXOTEL_API_TOKEN=xxx
EXOTEL_SUBDOMAIN=api.exotel.com         # or api.in.exotel.com (Mumbai cluster)
EXOTEL_EXOPHONE=0XXXXXXXXXX             # your Exotel virtual number (CallerId)
EXOTEL_FLOW_APP_ID=xxx                  # ID of the flow containing the Voicebot applet

# ---- Sarvam (speech-to-text + text-to-speech) ----
SARVAM_API_KEY=xxx
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=priya                # a female voice matches the wording of the scripts
